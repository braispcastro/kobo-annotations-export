---
import Layout from "../../../layouts/Layout.astro";
import { getBooksByAuthor } from "../../../db";

const { dbName, author } = Astro.params;

if (!dbName || !author) {
    return Astro.redirect("/");
}

const books = getBooksByAuthor(dbName, author);

if (books.length === 0) {
    return Astro.redirect(`/${dbName}/`);
}
---

<Layout title={`${author} | Books`} dbName={dbName}>
    <a
        slot="back-button"
        href={`/${dbName}/`}
        class="back-button"
        title="Back to Authors">&larr;</a
    >
    <span slot="header-title" class="header-context">{author}</span>

    <h1>{author}</h1>

    <div class="grid">
        {
            books.map((book) => (
                <a href={`/${dbName}/${author}/${book.title}/`} class="card">
                    <h2 style="font-size: 1.25rem;">{book.title}</h2>
                    <p style="color: var(--text-secondary);">
                        {book.annotationCount}{" "}
                        {book.annotationCount === 1
                            ? "Annotation"
                            : "Annotations"}
                    </p>
                </a>
            ))
        }
    </div>
</Layout>

<style>
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 0.5rem;
    }
    a.card {
        display: block;
        text-decoration: none;
        color: inherit;
    }
</style>
