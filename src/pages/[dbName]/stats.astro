---
import Layout from "../../layouts/Layout.astro";
import { getKoboStats, getDatabases } from "../../db";

const { dbName } = Astro.params;

const databases = getDatabases();
if (!dbName || !databases.includes(dbName)) {
    return Astro.redirect("/");
}

const stats = getKoboStats(dbName);

const colorMap: Record<string, string> = {
    "3": "var(--highlight-green)",
    "2": "var(--highlight-blue)",
    "1": "var(--highlight-pink)",
    "0": "var(--highlight-yellow)",
};

const totalAnnotColors = Object.values(stats.colorDistribution).reduce((a, b) => a + b, 0);
---

<Layout title="Statistics | Kobo Insights" dbName={dbName}>
    <a
        slot="back-button"
        href={`/${dbName}/`}
        class="back-button"
        title="Back to Authors">&larr;</a
    >
    <span slot="header-title" class="header-context">Reading Insights</span>

    <h1 style="margin-bottom: 2rem;">Reading Insights</h1>

    <!-- KPI Grid -->
    <div class="stats-grid">
        <div class="card stat-card">
            <span class="stat-icon">📚</span>
            <div class="stat-content">
                <span class="stat-value">{stats.totalBooks}</span>
                <span class="stat-label">Total Books</span>
            </div>
        </div>
        <div class="card stat-card">
            <span class="stat-icon">✅</span>
            <div class="stat-content">
                <span class="stat-value">{stats.readBooks}</span>
                <span class="stat-label">Finished</span>
            </div>
        </div>
        <div class="card stat-card">
            <span class="stat-icon">⏱️</span>
            <div class="stat-content">
                <span class="stat-value">{stats.timeSpentHours}h</span>
                <span class="stat-label">Time Reading</span>
            </div>
        </div>
        <div class="card stat-card">
            <span class="stat-icon">✍️</span>
            <div class="stat-content">
                <span class="stat-value">{stats.totalAnnotations}</span>
                <span class="stat-label">Annotations</span>
            </div>
        </div>
    </div>

    <div class="main-stats-container">
        <!-- Main Content -->
        <section>
            <h2 class="section-title">Continue Reading</h2>
            <div class="recent-list">
                {stats.recentBooks.length > 0 ? stats.recentBooks.map(book => (
                    <div class="card recent-card">
                        <div class="recent-info">
                            <h3>{book.title}</h3>
                            <p>{book.author}</p>
                        </div>
                        <div class="recent-progress">
                            <div class="progress-bar-bg">
                                <div class="progress-bar-fill" style={`width: ${book.progress}%`}></div>
                            </div>
                            <span>{book.progress}%</span>
                        </div>
                    </div>
                )) : (
                    <p style="opacity: 0.6; font-style: italic;">No books currently in progress.</p>
                )}
            </div>
        </section>

        <div class="stats-grid-bottom">
            <section>
                <h2 class="section-title">Highlight Colors</h2>
                <div class="card chart-card">
                    <div class="color-bars">
                        {Object.entries(stats.colorDistribution).sort((a,b) => b[1] - a[1]).map(([color, count]) => {
                            const percent = totalAnnotColors > 0 ? (count / totalAnnotColors) * 100 : 0;
                            if (count === 0) return null;
                            return (
                                <div class="color-bar-item">
                                    <div class="color-bar-info">
                                        <div class="color-preview" style={`background: ${colorMap[color]}`}></div>
                                        <span class="color-name">
                                            {color === "0" ? "Yellow" : color === "1" ? "Pink" : color === "2" ? "Blue" : "Green"}
                                        </span>
                                        <span class="color-count">{count}</span>
                                    </div>
                                    <div class="color-bar-bg">
                                        <div class="color-bar-fill" style={`width: ${percent}%; background: ${colorMap[color]}`}></div>
                                    </div>
                                </div>
                            );
                        })}
                    </div>
                </div>
            </section>

            <section>
                <h2 class="section-title">Reading Status</h2>
                <div class="card chart-card">
                    <div class="status-distribution">
                        <div class="status-item">
                            <span class="status-label">Finished</span>
                            <span class="status-value">{stats.readBooks}</span>
                        </div>
                        <div class="status-item">
                            <span class="status-label">In Progress</span>
                            <span class="status-value">{stats.readingBooks}</span>
                        </div>
                        <div class="status-item">
                            <span class="status-label">Unread</span>
                            <span class="status-value">{stats.totalBooks - stats.readBooks - stats.readingBooks}</span>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</Layout>

<style>
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 2.5rem;
    }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        padding: 1.5rem;
    }

    .stat-icon {
        font-size: 2rem;
        background: rgba(255, 255, 255, 0.05);
        width: 3.5rem;
        height: 3.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
    }

    .stat-value {
        display: block;
        font-size: 1.75rem;
        font-weight: 800;
        color: var(--text-primary);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .main-stats-container {
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .stats-grid-bottom {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
    }

    @media (max-width: 900px) {
        .stats-grid-bottom {
            grid-template-columns: 1fr;
        }
    }

    .section-title {
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-secondary);
        margin-bottom: 1.25rem;
    }

    .recent-list, .achievements-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .recent-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem;
    }

    .recent-info h3 {
        font-size: 1.1rem;
        margin-bottom: 0.25rem;
    }

    .recent-info p {
        font-size: 0.85rem;
        color: var(--text-secondary);
    }

    .recent-progress {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 140px;
    }

    .progress-bar-bg {
        flex: 1;
        height: 6px;
        background: rgba(127, 127, 127, 0.2);
        border-radius: 3px;
        overflow: hidden;
    }

    .progress-bar-fill {
        height: 100%;
        background: var(--accent);
    }

    .recent-progress span {
        font-size: 0.85rem;
        font-weight: 600;
        min-width: 40px;
        text-align: right;
    }

    .ach-card {
        display: flex;
        gap: 1rem;
        padding: 1rem;
        align-items: flex-start;
    }

    .ach-icon {
        font-size: 1.5rem;
        opacity: 0.8;
    }

    .ach-info strong {
        display: block;
        font-size: 0.95rem;
        margin-bottom: 0.15rem;
    }

    .ach-info p {
        font-size: 0.85rem;
        color: var(--text-secondary);
        margin-bottom: 0.5rem;
        line-height: 1.4;
    }

    .ach-date {
        font-size: 0.75rem;
        color: var(--text-secondary);
        opacity: 0.6;
    }

    /* Charts */
    .color-bars {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .color-bar-item {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .color-bar-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.9rem;
    }

    .color-preview {
        width: 12px;
        height: 12px;
        border-radius: 3px;
    }

    .color-name {
        flex: 1;
        font-weight: 500;
    }

    .color-count {
        font-weight: 700;
        opacity: 0.8;
    }

    .color-bar-bg {
        height: 8px;
        background: rgba(127, 127, 127, 0.1);
        border-radius: 4px;
        overflow: hidden;
    }

    .color-bar-fill {
        height: 100%;
        border-radius: 4px;
    }

    .status-distribution {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .status-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 0;
        border-bottom: 1px solid rgba(127, 127, 127, 0.1);
    }

    .status-item:last-child {
        border-bottom: none;
    }

    .status-label {
        font-weight: 500;
    }

    .status-value {
        font-weight: 700;
        color: var(--accent);
    }
</style>
